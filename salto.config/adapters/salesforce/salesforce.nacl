salesforce {
  fetch = {
    metadata = {
      include = [
        {
          metadataType = ".*"
          namespace = ""
          name = ".*"
        },
        {
          metadataType = ".*"
          namespace = "RTSK"
          name = ".*"
        }
      ]
      exclude = [
        
        {
          metadataType = "Automations"
        },
        {
          metadataType = "Bot"
        },
        {
          metadataType = "GenAiFunction"
        },
        {
          metadataType = "GenAiPlanner"
        },
        {
          metadataType = "GenAiPlugin"
        },
        {
          metadataType = "SharingRules"
        },
        {
          metadataType = "Report"
        },
        {
          metadataType = "ReportType"
        },
        {
          metadataType = "ReportFolder"
        },
        {
          metadataType = "Dashboard"
        },
        {
          metadataType = "DashboardFolder"
        },
        {
          metadataType = "Document"
        },
        {
          metadataType = "DocumentFolder"
        },
       
        {
          metadataType = "SiteDotCom"
        },
        {
          metadataType = "ContentAsset"
        },
    
        {
          metadataType = "AnalyticSnapshot"
        },
        {
          metadataType = "WaveDashboard"
        },
        {
          metadataType = "WaveDataflow"
        },
        {
          metadataType = "StandardValueSet"
          name = "^(AddressCountryCode)|(AddressStateCode)$"
          namespace = ""
        },
        {
          metadataType = "Layout"
          name = "CollaborationGroup-Group Layout"
        },
        {
          metadataType = "Layout"
          name = "CaseInteraction-Case Feed Layout"
        },
        {
          metadataType = "ExternalAIModel"
        },
        {
          metadataType = "ServiceAISetupDefinition"
        },
        {
          metadataType = "ServiceAISetupField"
        },
      ]
    }
    data =  {
        includeObjects = [
        "SBQQ__.*",
        "sbaa__ApprovalChain__c",
        "sbaa__ApprovalCondition__c",
        "sbaa__ApprovalRule__c",
        "sbaa__ApprovalVariable__c",
        "sbaa__Approver__c",
        "sbaa__EmailTemplate__c",
        "sbaa__TrackedField__c",
      ]
       saltoIDSettings =  {
        defaultIdFields = [
          "Id"
        ]
        overrides =  [
          {
            objectsRegex = ".*SBQQBlockPriceName.*"
            idFields =  [
              "SaltoExtId__c"
            ]
          },
        ]
       }
    }
  }
    maxItemsInRetrieveRequest = 2500
}

